<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU1902;NU1903;NU1901;NU1904</NoWarn>

    <PackageId>Clockwork.Umbraco.ImageFrame</PackageId>
    <Version>1.0.0</Version>
    <Title>Clockwork Image Frame</Title>
    <Authors>Clockwork</Authors>
    <Company>Clockwork</Company>
    <Product>Clockwork Image Frame</Product>
    <Description>An image picker for Umbraco that places every image inside a fixed frame (for example 300×150) where editors can zoom in and out, pan, rotate and flip, just like a profile picture editor. It keeps logos, partner badges, icons and cover images visually consistent. Supports Umbraco 13, 17 and 18.</Description>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-cms;image;crop;cropper;logo;media;property-editor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/alperenkapusuz58/Clockwork.Umbraco.ImageFrame</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alperenkapusuz58/Clockwork.Umbraco.ImageFrame</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © Clockwork</Copyright>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[13.0.0,14.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="[13.0.0,14.0.0)" />
    <PackageReference Include="Umbraco.Cms.Imaging.ImageSharp" Version="[13.0.0,14.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.0.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="[17.0.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Imaging.ImageSharp" Version="[17.0.0,19.0.0)" />
  </ItemGroup>

  <!--
    Static web assets can't differ per target framework in a NuGet package, so both back-office
    implementations ship together: Umbraco 13 only reads package.manifest (+ v13/, lang/),
    Umbraco 17/18 only read umbraco-package.json (+ dist/).
  -->

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Clockwork.Umbraco.ImageFrame.Tests" />
  </ItemGroup>

</Project>
